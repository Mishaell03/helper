+    if (GetForegroundWindow() == window_) {
+      SetFocus(nullptr);
+      SetActiveWindow(nullptr);
+    }
+    keyboard_previous_foreground_ = nullptr;
+    keyboard_previous_process_ = keyboard_previous_thread_ = 0;
+  }
+  return styles_applied;
+}
